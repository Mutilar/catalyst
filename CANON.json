ay"],"freshness":"Current-session or content-addressed generation identity is required.","bounded":"The owning adapter enforces explicit byte, item, and lifecycle bounds."},{"id":"output.gateway","target":"catalyst/gateway","contract":"Cross-platform messaging and API adapters.","evidence_refs":["evidence.gateway"],"freshness":"Current-session or content-addressed generation identity is required.","bounded":"The owning adapter enforces explicit byte, item, and lifecycle bounds."}],"invariants":[{"id":"invariant.safe-recycle","statement":"A stale worker completes an active command, refuses the next unstarted command with runtime-stale, closes transports, and exits before replay.","equation":"active completes; unstarted refuses; replacement replays at most once","evidence_refs":["evidence.worker","evidence.gateway"]},{"id":"invariant.no-unknown-replay","statement":"The parent replays at most once and only when typed evidence proves the command never started.","equation":"retry iff runtime-stale and not-started","evidence_refs":["evidence.gateway"]},{"id":"invariant.explicit-role","statement":"LUCID sign-in selects EM or SIDEKICK explicitly; no Catalyst path silently defaults to EM.","equation":"signin role in {EM,SIDEKICK}","evidence_refs":["evidence.desktop","evidence.gateway"]}],"mechanisms":[{"id":"mechanism.generation-fingerprint","statement":"Generation fingerprints bind imported Python sources, package locks, and RUN's current Butler generation pointer.","ordered_steps":["fingerprint sources","finish active command","refuse unstarted command","replace worker"],"evidence_refs":["evidence.worker"],"consequences":["Preserves explicit ownership and typed failure semantics."]},{"id":"mechanism.runtime-stale","statement":"Typed runtime-stale exchange separates safe non-execution replay from unknown-outcome operations.","ordered_steps":["detect drift","emit typed refusal","close MCP","replay once"],"evidence_refs":["evidence.worker","evidence.gateway"],"consequences":["Preserves explicit ownership and typed failure semantics."]},{"id":"mechanism.authority-seams","statement":"Electron owns machine effects, the renderer owns ephemeral presentation, and the gateway owns shared agent work.","ordered_steps":["route intent","validate boundary","execute at owner","reconcile presentation"],"evidence_refs":["evidence.desktop"],"consequences":["Preserves explicit ownership and typed failure semantics."]}],"failure_modes":[{"id":"failure.overlay-missing","trigger":"Canonical project declarations are absent from catalyst/.","consequence":"QUINE graph loading refuses the registered project.","detection":"missing-reference at catalyst/SPEC.json or catalyst/CANON.json","behavior":"fail-closed","evidence_refs":["evidence.spec","evidence.canon"]},{"id":"failure.unknown-replay","trigger":"A parent retries without proof of non-execution.","consequence":"Consequential operations can execute twice.","detection":"No runtime-stale not-started receipt exists.","behavior":"reject-and-report","evidence_refs":["evidence.gateway"]},{"id":"failure.implicit-role","trigger":"A host silently supplies EM during sign-in.","consequence":"The selected authority differs from user intent.","detection":"No explicit role-selection fact exists.","behavior":"reject-and-report","evidence_refs":["evidence.desktop","evidence.gateway"]}],"evidence":[{"id":"evidence.repo-map","path":"quine/canon/repo_map.json","claim":"Catalyst is registered as the peripheral desktop executive shell."},{"id":"evidence.spec","path":"catalyst/SPEC.json","claim":"Catalyst owns its QUINE area and quality declaration."},{"id":"evidence.canon","path":"catalyst/CANON.json","claim":"Catalyst owns its structured project truth."},{"id":"evidence.worker","path":"catalyst/tui_gateway/slash_worker.py","claim":"Worker generation detection and typed stale refusal."},{"id":"evidence.gateway","path":"catalyst/tui_gateway/server.py","claim":"Session-preserving replacement and bounded replay."},{"id":"evidence.