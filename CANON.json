{"$schema":"https://agentexperiments.local/envelope/CANON.schema.json","schema":"agentexperiments-project-canon/1","project":{"id":"catalyst","root":"catalyst/"},"content_address":{"algorithm":"sha256","canonicalization":"quine-json-c14n-v1","scope":"entire-document","emitted_by":"quine-project-canon-receipt"},"truth":{"identity":{"id":"identity.catalyst","name":"Catalyst","statement":"Catalyst is the desktop executive shell that packages Hermes Agent, hosts Electron and React interaction surfaces, and connects user intent to canonical RUN, Butler, and UGUI owners without assuming their authority.","evidence_refs":["evidence.repo-map","evidence.desktop"]},"anatomical_role":{"id":"role.desktop-executive-shell","statement":"Catalyst is a peripheral executive shell: it presents, routes, and supervises interaction while central runtime, protocol, storage, and projection semantics remain with their canonical owners.","evidence_refs":["evidence.repo-map","evidence.desktop"]},"purpose":[{"id":"purpose.cross-platform-experience","statement":"Provide one cross-platform CLI, gateway, TUI, web, and desktop experience over the Hermes Agent core.","evidence_refs":["evidence.package","evidence.python-package"]},{"id":"purpose.session-continuity","statement":"Preserve durable conversation, model, profile, history, and UI identity while workers recycle across source and Butler runtime generations.","evidence_refs":["evidence.worker","evidence.gateway"]},{"id":"purpose.explicit-lucid-role","statement":"Carry explicit LUCID role selection and bounded semantic intents across the desktop-to-Butler boundary.","evidence_refs":["evidence.desktop","evidence.gateway"]}],"boundaries":[{"id":"boundary.semantic-authority","kind":"ownership","statement":"Catalyst does not own LUCID grammar, Butler authority, RUN lifecycle truth, QUINE verdicts, Store durability, or UGUI document semantics.","rejects":["duplicated protocol authority","inferred effect truth"],"evidence_refs":["evidence.repo-map"]